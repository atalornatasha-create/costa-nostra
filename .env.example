# Production runtime
NODE_ENV=production
PORT=10000
REQUIRE_DATABASE=true
APP_URL=https://YOUR-SERVICE.onrender.com
PHASE_MS=90000

# PostgreSQL (Neon/Supabase/etc.)
# Keep this secret. Prefer a pooled/transaction-pool URL if your provider supplies one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Separate administrator accounts
NATASHA_ADMIN_EMAIL=natasha@example.com
NATASHA_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
NATASHA_ADMIN_NAME=Natasha
NATASHA_ADMIN_INSTAGRAM=
NATASHA_ADMIN_FACEBOOK=
NATASHA_ADMIN_TIKTOK=
NATASHA_ADMIN_X=
NATASHA_ADMIN_SNAPCHAT=

PEACE_ADMIN_EMAIL=peace@example.com
PEACE_ADMIN_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_LONG_UNIQUE_PASSWORD
PEACE_ADMIN_NAME=Peace
PEACE_ADMIN_INSTAGRAM=
PEACE_ADMIN_FACEBOOK=
PEACE_ADMIN_TIKTOK=
PEACE_ADMIN_X=
PEACE_ADMIN_SNAPCHAT=

# Stripe — server-side only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/auth/google/callback

# Password reset email (optional; Render free blocks SMTP ports 25/465/587)
# Use an HTTPS email API/transactional email provider for a free-tier deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
